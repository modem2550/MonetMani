---
// ./pages/index.astro
import MainLayout from "@/app/layouts/MainLayout.astro";
import EventCard from "@/shared/components/EventCard.astro";
import { getSupabase } from "@/services/supabase/server";
import { categorizeEvents } from "@/shared/utils/dateUtils";
import socialData from "../data/social.json";
import type { Event } from "@/types/event";

// ── Cache ──────────────────────────────────────────────────────────────────────
const CACHE_TTL_SECONDS = 60;
Astro.response.headers.set(
  "Cache-Control",
  `public, max-age=0, s-maxage=${CACHE_TTL_SECONDS}, stale-while-revalidate=${CACHE_TTL_SECONDS}`,
);

// ── Data fetching ─────────────────────────────────────────────────────────────

const supabase = getSupabase();
let allEvents: Event[] = [];

if (supabase) {
  try {
    const { data } = await supabase
      .from("events_upcoming")
      .select("*")
      .order("date", { ascending: false });
    allEvents = data ?? [];
  } catch (e) {
    // Error fetching upcoming events — allEvents will remain empty
  }
}

// ── Categorize & process ──────────────────────────────────────────────────────

const { upcoming, past } = categorizeEvents(allEvents);

function toSlug(text: string) {
  return text
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "-")
    .replace(/[()]/g, "")
    .replace(/[^a-z0-9-]/g, "");
}

const withSlug = (event: Event) => ({
  ...event,
  generated_slug: `${toSlug(event.title || "event")}-${event.id}`,
});

const processedUpcoming = upcoming.map(withSlug);
const processedPast = past.map(withSlug);
