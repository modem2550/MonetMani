      const expiryDate = new Date("2026-11-12T23:59:59+07:00");

      if (!hidePromo && currentDate <= expiryDate) {
        promoOverlay.classList.add("active");
      }

      window.closePromoPopup = () => {
        promoOverlay.classList.remove("active");
      };

      window.neverShowPromoPopup = () => {
        localStorage.setItem("hidePromoPopup", "true");
        promoOverlay.classList.remove("active");
      };
    });
  </script>
</MainLayout>
