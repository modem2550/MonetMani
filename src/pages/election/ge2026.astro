                                  src={getGe2026ImageUrl(c)}
                                  alt={c.name}
                                  class="rounded-circle object-fit-cover flex-shrink-0"
                                  style="border-color: var(--c-border) !important; object-position: top;"
                                  loading="lazy"
                                  width="48"
                                  height="48"
                                />
                                <div>
                                  <div
                                    class="fw-bold"
                                    style="color: var(--c-content); line-height: 1.3;"
                                  >
                                    {c.name}
                                  </div>
                                  <div
                                    class="small fw-semibold mb-1"
                                    style={`color: ${bandColorVar(c.band)};`}
                                  >
                                    {c.band} {c.team}
                                  </div>
                                  {c.expectation && (
                                    <div class="small mb-1">
                                      อันดับที่คาดหวัง:{" "}
                                      <strong>
                                        {c.id === "Wawa_BNK48" ? (
                                          <>
                                            อันดับ 21{" "}
                                            <span style="display:inline-block; transform: rotate(180deg);">
                                              (21)
                                            </span>
                                          </>
                                        ) : (
                                          c.expectation
                                        )}
                                      </strong>
                                    </div>
                                  )}
                                  <ol class="mb-0 mt-1 ps-3 small fw-medium">
                                    {c.songs.map((s: string) => (
                                      <li class="ge2026-song-li text-nowrap">
                                        {s}
                                      </li>
                                    ))}
                                  </ol>
                                </div>
                              </div>
                            ))}
                          </div>
                        ));
                      })()}
