        </div>

        {
          resultStages.map((stage) => {
            const stageCenterSongs = resolveStageCenterSongs(stage.key);
            return (
              <div
                class="ge2026-stage-panel"
                data-stage-panel={stage.key}
                style={stage.key === "final" ? "" : "display:none;"}
              >
                <div class="row justify-content-center g-4">
                  {resultCategories.map((cat) => {
                    const rows = rowsForStageAndCategory(
                      stage.key,
                      cat.min,
                      cat.max,
                    );
                    const rowByRank = new Map(
                      rows.map((row: any) => [row.rank, row]),
                    );
                    const rankNumbers = Array.from(
                      { length: cat.max - cat.min + 1 },
                      (_, i) => cat.min + i,
                    );
                    return (
                      <div class="col-12 col-lg-4 mt-4 mb-4">
                        <div
                          class="rank-heading"
                          style={`background: ${cat.bg};`}
                        >
                          <h3 class="mb-0 fw-bold text-center">{cat.title}</h3>
                          <div class="rank-song">
                            {stageCenterSongs[cat.key] ?? "N/A"}
                          </div>
                        </div>
                        <div class="rank-grid" style={`--cat-bg: ${cat.bg};`}>
                          {rankNumbers.map((rankNum, i) => {
                            const row: any = rowByRank.get(rankNum);
                            const change = row
                              ? getRankChange(
                                  stage.key as Ge2026Stage,
                                  rankNum,
                                  row.member_name,
                                  row.band,
                                )
                              : null;
                            return (
                              <div
                                class={`rank-card${i === 0 ? " center" : ""}`}
                              >
                                <div
                                  class="rank"
                                  style={
                                    row?.band
                                      ? `background: ${bandColorVar(row.band)};`
                                      : ""
                                  }
                                >
                                  {rankNum}
                                </div>
                                <div class="pic">
                                  {row?.image_url && (
                                    <img
                                      class="mem-pic"
                                      src={row.image_url}
                                      width="1080"
                                      height="1080"
                                      loading="lazy"
                                      alt=""
                                      onerror="this.style.display='none';"
                                    />
                                  )}
                                </div>
                                <div class="info">
                                  <div class="name">
                                    {row ? (
                                      `${row.member_name} ${row.band ?? ""}`
                                    ) : (
                                      <p class="placeholder-wave">
                                        <span class="placeholder" />
                                      </p>
                                    )}
                                  </div>
                                  {change && (
                                    <div class="rank-change">
                                      {change === "new" ? (
                                        <span class="rank-change__badge rank-change__badge--new">
                                          <i
                                            class="fa-solid fa-sparkles"
                                            aria-hidden="true"
                                          />{" "}
                                          NEW
                                        </span>
                                      ) : change.diff > 0 ? (
                                        <span class="rank-change__badge rank-change__badge--up">
                                          <i
                                            class="fa-solid fa-arrow-up"
                                            aria-hidden="true"
                                          />{" "}
                                          {change.diff}
                                        </span>
                                      ) : change.diff < 0 ? (
                                        <span class="rank-change__badge rank-change__badge--down">
                                          <i
                                            class="fa-solid fa-arrow-down"
                                            aria-hidden="true"
                                          />{" "}
                                          {Math.abs(change.diff)}
                                        </span>
                                      ) : (
                                        <span class="rank-change__badge rank-change__badge--same">
                                          <i
                                            class="fa-solid fa-minus"
                                            aria-hidden="true"
                                          />
                                        </span>
                                      )}
                                    </div>
                                  )}
                                </div>
                                <div class="token">
                                  {row?.token != null
                                    ? Number(row.token).toLocaleString("en-US")
                                    : ""}
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })
        }

        <div
          class="text-center pt-3 mt-4 border-top fw-semibold small"
          style="color: var(--c-content-muted); border-color: var(--c-border) !important;"
        >
          Niya BNK48 Fan Website — GE2026 Tracker
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<!-- Candidate Detail Modal -->
<div
  class="modal fade"
  id="ge2026-candidate-modal"
  tabindex="-1"
  aria-hidden="true"
>
  <div
    class="d-flex justify-content-center modal-dialog modal-dialog-centered modal-lg"
  >
    <div
      class="modal-content"
      style="border-color: var(--c-border); background: var(--c-bg);"
    >
      <div
        class="modal-header border-0 pt-4 px-4 pb-0"
        style="border-color: var(--c-border) !important;"
      >
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
          style="filter: var(--btn-close-filter);"></button>
      </div>
      <div
        class="modal-body pt-0 px-4 pb-4"
        id="ge2026-candidate-modal-content"
      >
        <!-- Dynamic content will be injected here -->
      </div>
    </div>
  </div>
</div>

<script>
  // Enables data-bs-toggle="pill" tab switching (side-effect import registers
  // Bootstrap's document-level click delegation — no manual init needed).
  import "bootstrap/js/dist/tab.js";
  import "bootstrap/js/dist/modal.js";

  import {
    ge2026Candidates,
    getGe2026ImageUrl,
  } from "@/features/events/data/ge-2026";
  import {
    CATEGORY_LABEL,
    resolveCenterSongs,
  } from "@/features/events/ge2026SongEngine";

  // ── Candidate view switcher (list vs. expectation groups) ─────────────
  const viewBtns =
    document.querySelectorAll<HTMLButtonElement>(".ge2026-view-btn");
  const viewList = document.getElementById("ge2026-view-list");
  const viewExpectation = document.getElementById("ge2026-view-expectation");

  viewBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      viewBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const view = btn.dataset.view;
      viewList?.classList.toggle("d-none", view !== "list");
      viewExpectation?.classList.toggle("d-none", view !== "expectation");
    });
  });

  // ── Candidate search filter (list view — has its own search + filter modal) ──
  const searchInput = document.getElementById(
    "ge2026-candidate-search",
  ) as HTMLInputElement | null;
  const brandSelect = document.getElementById(
    "filter-brand",
  ) as HTMLSelectElement | null;
  const teamSelect = document.getElementById(
    "filter-team",
  ) as HTMLSelectElement | null;
  const genSelect = document.getElementById(
    "filter-gen",
  ) as HTMLSelectElement | null;
  const btnClear = document.getElementById("btn-clear-filter");

  function applyFilters() {
    const q = searchInput?.value.trim().toLowerCase() || "";
    const brand = brandSelect?.value || "";
    const team = teamSelect?.value || "";
    const gen = genSelect?.value || "";

    document
      .querySelectorAll<HTMLElement>("#ge2026-view-list .candidate-item")
      .forEach((item) => {
        const haystack = item.dataset.search ?? "";
        const itemBrand = item.dataset.brand;
        const itemTeam = item.dataset.team;
        const itemGen = item.dataset.gen;

        const matchSearch = q.length === 0 || haystack.includes(q);
        const matchBrand = !brand || itemBrand === brand;
        const matchTeam = !team || itemTeam === team;
        const matchGen = !gen || itemGen === gen;

        if (matchSearch && matchBrand && matchTeam && matchGen) {
          item.classList.remove("d-none");
          item.classList.add("d-flex");
        } else {
          item.classList.add("d-none");
          item.classList.remove("d-flex");
        }
      });
  }

  searchInput?.addEventListener("input", applyFilters);
  brandSelect?.addEventListener("change", applyFilters);
  teamSelect?.addEventListener("change", applyFilters);
  genSelect?.addEventListener("change", applyFilters);

  btnClear?.addEventListener("click", () => {
    if (brandSelect) brandSelect.value = "";
    if (teamSelect) teamSelect.value = "";
    if (genSelect) genSelect.value = "";
    applyFilters();
  });

  // ── Expectation-group search (independent from the list view's filter) ──
  const expSearchInput = document.getElementById(
    "ge2026-expectation-search",
  ) as HTMLInputElement | null;

  function applyExpectationFilter() {
    const q = expSearchInput?.value.trim().toLowerCase() || "";

    document
      .querySelectorAll<HTMLElement>("#ge2026-view-expectation .candidate-item")
      .forEach((item) => {
        const haystack = item.dataset.search ?? "";
        const matchSearch = q.length === 0 || haystack.includes(q);
        item.classList.toggle("d-none", !matchSearch);
        item.classList.toggle("d-flex", matchSearch);
      });

    document
      .querySelectorAll<HTMLElement>(
        "#ge2026-view-expectation .expected-rank-group",
      )
      .forEach((group) => {
        const hasVisible = Array.from(
          group.querySelectorAll(".candidate-item"),
        ).some((item) => !item.classList.contains("d-none"));
        group.classList.toggle("d-none", !hasVisible);
      });
  }

  expSearchInput?.addEventListener("input", applyExpectationFilter);

  // ── Result stage switcher (ผลด่วน#1 / ผลด่วน#2 / ผลจริง) ───────────────
  const stageBtns =
    document.querySelectorAll<HTMLButtonElement>(".ge2026-stage-btn");
  stageBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      stageBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const stage = btn.dataset.stage;
      document
        .querySelectorAll<HTMLElement>(".ge2026-stage-panel")
        .forEach((panel) => {
          panel.style.display =
            panel.dataset.stagePanel === stage ? "" : "none";
        });
    });
  });

  // ── Song catalogue explorer ───────────────────────────────────────────
  type SongPayload = {
    id: string;
    title: string;
    count: number;
    band: string;
    singleName: string | null;
    singleNo: string | null;
    release: string | null;
    note: string | null;
    imageUrl: string | null;
    links: {
      youtube: string | null;
      apple: string | null;
      spotify: string | null;
    };
    picks: Array<{
      name: string;
      band: string;
      gen: string;
      team: string;
      priority: number;
      image: string;
    }>;
  };

  const songPayloadEl = document.getElementById("ge2026-song-payload");
  const songCardsEl = document.getElementById("ge2026-song-cards");
  const songFilterBody = document.getElementById("ge2026-filter-body");
  const songFilterModalContent = document.getElementById(
    "ge2026-filter-modal-content",
  );
  const songSearch = document.getElementById(
    "ge2026-song-search",
  ) as HTMLInputElement | null;
  const songSummary = document.getElementById("ge2026-results-summary");
  const songFilterSummary = document.getElementById("ge2026-filter-summary");
  const songPayload = songPayloadEl
    ? (JSON.parse(songPayloadEl.textContent || "[]") as SongPayload[])
    : [];
  const songById = new Map(songPayload.map((song) => [song.id, song]));
  let activeSongFilter = { category: "", value: "" };
  let songSortMode = "count";
  let songSortDirection: "asc" | "desc" = "desc";

  if (songFilterBody && songFilterModalContent) {
    songFilterModalContent.appendChild(songFilterBody);
  }

  const escapeSongHtml = (value: string) =>
    value.replace(
      /[&<>'"]/g,
      (character) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          "'": "&#39;",
          '"': "&quot;",
        })[character] || character,
    );

  function songMatchesFilter(song: SongPayload) {
    const query = songSearch?.value.trim().toLowerCase() || "";
    const searchableText = [
      song.title,
      song.band,
      song.singleName,
      song.singleNo,
    ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();
    if (query && !searchableText.includes(query)) return false;

    const { category, value } = activeSongFilter;
    if (!category || !value) return true;
    if (category === "band") return song.band === value;
    return song.picks.some((pick) => {
      if (category === "priority") return String(pick.priority) === value;
      if (category === "memberBand") return pick.band === value;
      if (category === "gen") return pick.gen === value;
      if (category === "team") return pick.team === value;
      return false;
    });
  }

  function updateSongExplorer() {
    const visibleSongs = songPayload.filter(songMatchesFilter);
    const sortedSongs = [...visibleSongs].sort((a, b) => {
      const comparison =
        songSortMode === "alpha"
          ? a.title.localeCompare(b.title)
          : a.count - b.count || a.title.localeCompare(b.title);
      return songSortDirection === "desc" ? -comparison : comparison;
    });
    const visibleIds = new Set(sortedSongs.map((song) => song.id));

    songCardsEl?.querySelectorAll<HTMLElement>(".song-card").forEach((card) => {
      const isVisible = visibleIds.has(card.dataset.songId || "");
      card.hidden = !isVisible;
    });
    sortedSongs.forEach((song) => {
      const card = songCardsEl?.querySelector<HTMLElement>(
        `[data-song-id="${CSS.escape(song.id)}"]`,
      );
      if (card) songCardsEl?.appendChild(card);
    });

    const selectedLabel = activeSongFilter.value
      ? document
          .querySelector<HTMLElement>(
            `.song-filter__chip.is-active[data-category="${CSS.escape(activeSongFilter.category)}"] .song-filter__chip-name`,
          )
          ?.textContent?.trim()
      : "ทั้งหมด";
    if (songSummary) {
      songSummary.textContent = `แสดง ${sortedSongs.length} จาก ${songPayload.length} เพลง`;
    }
    if (songFilterSummary) {
      songFilterSummary.textContent = activeSongFilter.value
        ? `${selectedLabel || "เลือกแล้ว"} · ${sortedSongs.length} เพลง`
        : `ทั้งหมด ${songPayload.length} เพลง`;
    }
  }

  songSearch?.addEventListener("input", updateSongExplorer);

  songFilterModalContent?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const tab = target.closest<HTMLButtonElement>(".song-filter__tab");
    const chip = target.closest<HTMLButtonElement>(".song-filter__chip");
    const reset = target.closest<HTMLButtonElement>("#ge2026-filter-reset");

    if (tab) {
      const category = tab.dataset.category || "";
      songFilterModalContent
        ?.querySelectorAll(".song-filter__tab")
        .forEach((item) => {
          item.classList.toggle("is-active", item === tab);
          item.setAttribute("aria-selected", String(item === tab));
        });
      songFilterModalContent
        ?.querySelectorAll<HTMLElement>(".song-filter__panel")
        .forEach((panel) => {
          panel.style.display =
            panel.dataset.categoryPanel === category ? "" : "none";
        });
      return;
    }

    if (chip) {
      activeSongFilter = {
        category: chip.dataset.category || "",
        value: chip.dataset.value || "",
      };
      songFilterModalContent
        ?.querySelectorAll(".song-filter__chip")
        .forEach((item) => {
          item.classList.toggle("is-active", item === chip);
        });
      updateSongExplorer();
      return;
    }

    if (reset) {
      if (songSearch) songSearch.value = "";
      activeSongFilter = { category: "", value: "" };
      songFilterModalContent
        ?.querySelectorAll<HTMLElement>(".song-filter__chip")
        .forEach((item) => {
          item.classList.toggle("is-active", item.dataset.value === "");
        });
      updateSongExplorer();
    }
  });

  document
    .getElementById("ge2026-song-sort")
    ?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const mode = target.closest<HTMLButtonElement>("[data-sort-mode]");
      const direction = target.closest<HTMLButtonElement>("#ge2026-sort-dir");
      if (mode) {
        songSortMode = mode.dataset.sortMode || "count";
        document.querySelectorAll("[data-sort-mode]").forEach((item) => {
          item.classList.toggle("is-active", item === mode);
        });
        updateSongExplorer();
      }
      if (direction) {
        songSortDirection = songSortDirection === "desc" ? "asc" : "desc";
        direction.dataset.dir = songSortDirection;
        direction.setAttribute(
          "aria-label",
          songSortDirection === "desc"
            ? "สลับทิศทางการเรียง มาก→น้อย"
            : "สลับทิศทางการเรียง น้อย→มาก",
        );
        updateSongExplorer();
      }
    });

  // Fill the single static song modal from the clicked card's data.
  songCardsEl?.addEventListener("click", (event) => {
    const card = (event.target as HTMLElement).closest<HTMLButtonElement>(
      ".song-card",
    );
    const song = card ? songById.get(card.dataset.songId || "") : null;
    if (!song) return;

    const modalContentBox = document.getElementById(
      "ge2026-song-modal-content",
    );
    const modalTitle = document.getElementById("ge2026-modal-title");
    const modalBand = document.getElementById("ge2026-modal-band");
    const modalRelease = document.getElementById("ge2026-modal-release");
    const modalSingle = document.getElementById("ge2026-modal-single");
    const modalCount = document.getElementById("ge2026-modal-count");
    const modalArt = document.getElementById("ge2026-modal-art");
    const modalLinks = document.getElementById("ge2026-modal-links");
    const modalMembers = document.getElementById("ge2026-modal-members");
    if (
      !modalContentBox ||
      !modalTitle ||
      !modalBand ||
      !modalRelease ||
      !modalSingle ||
      !modalCount ||
      !modalArt ||
      !modalLinks ||
      !modalMembers
    )
      return;

    // Background image of the modal card itself — one image only, and
    // reset per open so the previous song's image never lingers.
    if (song.imageUrl) {
      modalContentBox.style.backgroundImage = `url('${escapeSongHtml(song.imageUrl)}')`;
    } else {
      modalContentBox.style.backgroundImage = "none";
    }
    type SongLinkMeta = { color: string; icon: string };

    const songLinkMeta: { [key: string]: SongLinkMeta } = {
      youtube: {
        color: "#FF0000",
        icon: `<svg viewBox="0 0 176 176" xmlns="http://www.w3.org/2000/svg"><circle cx="88" cy="88" r="88" fill="#FF0000"/><path fill="#FFFFFF" d="M88,46c23.1,0,42,18.8,42,42s-18.8,42-42,42s-42-18.8-42-42S64.9,46,88,46 M88,42c-25.4,0-46,20.6-46,46s20.6,46,46,46s46-20.6,46-46S113.4,42,88,42L88,42z"/><polygon fill="#FFFFFF" points="72,111 111,87 72,65"/></svg>`,
      },
      apple: {
        color: "#FA233B",
        icon: `<svg viewBox="0 0 361 361" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="appleMusicGrad" x1="180" y1="358.6" x2="180" y2="7.76" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FA233B"/><stop offset="1" stop-color="#FB5C74"/></linearGradient></defs><path fill="url(#appleMusicGrad)" d="M360,112.61c0-4.3,0-8.6-0.02-12.9c-0.02-3.62-0.06-7.24-0.16-10.86c-0.21-7.89-0.68-15.84-2.08-23.64c-1.42-7.92-3.75-15.29-7.41-22.49c-3.6-7.07-8.3-13.53-13.91-19.14c-5.61-5.61-12.08-10.31-19.15-13.91c-7.19-3.66-14.56-5.98-22.47-7.41c-7.8-1.4-15.76-1.87-23.65-2.08c-3.62-0.1-7.24-0.14-10.86-0.16C255.99,0,251.69,0,247.39,0H112.61c-4.3,0-8.6,0-12.9,0.02c-3.62,0.02-7.24,0.06-10.86,0.16C80.96,0.4,73,0.86,65.2,2.27c-7.92,1.42-15.28,3.75-22.47,7.41c-7.07,3.6-13.54,8.3-19.15,13.91c-5.61,5.61-10.31,12.07-13.91,19.14c-3.66,7.2-5.99,14.57-7.41,22.49c-1.4,7.8-1.87,15.76-2.08,23.64c-0.1,3.62-0.14,7.24-0.16,10.86C0,104.01,0,108.31,0,112.61v134.77c0,4.3,0,8.6,0.02,12.9c0.02,3.62,0.06,7.24,0.16,10.86c0.21,7.89,0.68,15.84,2.08,23.64c1.42,7.92,3.75,15.29,7.41,22.49c3.6,7.07,8.3,13.53,13.91,19.14c5.61,5.61,12.08,10.31,19.15,13.91c7.19,3.66,14.56,5.98,22.47,7.41c7.8,1.4,15.76,1.87,23.65,2.08c3.62,0.1,7.24,0.14,10.86,0.16c4.3,0.03,8.6,0.02,12.9,0.02h134.77c4.3,0,8.6,0,12.9-0.02c3.62-0.02,7.24-0.06,10.86-0.16c7.89-0.21,15.85-0.68,23.65-2.08c7.92-1.42,15.28-3.75,22.47-7.41c7.07-3.6,13.54-8.3,19.15-13.91c5.61-5.61,10.31-12.07,13.91-19.14c3.66-7.2,5.99-14.57,7.41-22.49c1.4-7.8,1.87-15.76,2.08-23.64c0.1-3.62,0.14-7.24,0.16-10.86c0.03-4.3,0.02-8.6,0.02-12.9V112.61z"/><path fill="#FFFFFF" d="M254.5,55c-0.87,0.08-8.6,1.45-9.53,1.64l-107,21.59l-0.04,0.01c-2.79,0.59-4.98,1.58-6.67,3c-2.04,1.71-3.17,4.13-3.6,6.95c-0.09,0.6-0.24,1.82-0.24,3.62c0,0,0,109.32,0,133.92c0,3.13-0.25,6.17-2.37,8.76c-2.12,2.59-4.74,3.37-7.81,3.99c-2.33,0.47-4.66,0.94-6.99,1.41c-8.84,1.78-14.59,2.99-19.8,5.01c-4.98,1.93-8.71,4.39-11.68,7.51c-5.89,6.17-8.28,14.54-7.46,22.38c0.7,6.69,3.71,13.09,8.88,17.82c3.49,3.2,7.85,5.63,12.99,6.66c5.33,1.07,11.01,0.7,19.31-0.98c4.42-0.89,8.56-2.28,12.5-4.61c3.9-2.3,7.24-5.37,9.85-9.11c2.62-3.75,4.31-7.92,5.24-12.35c0.96-4.57,1.19-8.7,1.19-13.26l0-116.15c0-6.22,1.76-7.86,6.78-9.08c0,0,88.94-17.94,93.09-18.75c5.79-1.11,8.52,0.54,8.52,6.61l0,79.29c0,3.14-0.03,6.32-2.17,8.92c-2.12,2.59-4.74,3.37-7.81,3.99c-2.33,0.47-4.66,0.94-6.99,1.41c-8.84,1.78-14.59,2.99-19.8,5.01c-4.98,1.93-8.71,4.39-11.68,7.51c-5.89,6.17-8.49,14.54-7.67,22.38c0.7,6.69,3.92,13.09,9.09,17.82c3.49,3.2,7.85,5.56,12.99,6.6c5.33,1.07,11.01,0.69,19.31-0.98c4.42-0.89,8.56-2.22,12.5-4.55c3.9-2.3,7.24-5.37,9.85-9.11c2.62-3.75,4.31-7.92,5.24-12.35c0.96-4.57,1-8.7,1-13.26V64.46C263.54,58.3,260.29,54.5,254.5,55z"/></svg>`,
      },
      spotify: {
        color: "#1ed760",
        icon: `<svg viewBox="0 0 496 512" xmlns="http://www.w3.org/2000/svg"><path fill="#1ed760" d="M248 8C111.1 8 0 119.1 0 256s111.1 248 248 248 248-111.1 248-248S384.9 8 248 8Z"/><path fill="#FFFFFF" d="M406.6 231.1c-5.2 0-8.4-1.3-12.9-3.9-71.2-42.5-198.5-52.7-280.9-29.7-3.6 1-8.1 2.6-12.9 2.6-13.2 0-23.3-10.3-23.3-23.6 0-13.6 8.4-21.3 17.4-23.9 35.2-10.3 74.6-15.2 117.5-15.2 73 0 149.5 15.2 205.4 47.8 7.8 4.5 12.9 10.7 12.9 22.6 0 13.6-11 23.3-23.2 23.3zm-31 76.2c-5.2 0-8.7-2.3-12.3-4.2-62.5-37-155.7-51.9-238.6-29.4-4.8 1.3-7.4 2.6-11.9 2.6-10.7 0-19.4-8.7-19.4-19.4s5.2-17.8 15.5-20.7c27.8-7.8 56.2-13.6 97.8-13.6 64.9 0 127.6 16.1 177 45.5 8.1 4.8 11.3 11 11.3 19.7-.1 10.8-8.5 19.5-19.4 19.5zm-26.9 65.6c-4.2 0-6.8-1.3-10.7-3.6-62.4-37.6-135-39.2-206.7-24.5-3.9 1-9 2.6-11.9 2.6-9.7 0-15.8-7.7-15.8-15.8 0-10.3 6.1-15.2 13.6-16.8 81.9-18.1 165.6-16.5 237 26.2 6.1 3.9 9.7 7.4 9.7 16.5s-7.1 15.4-15.2 15.4z"/></svg>`,
      },
    };

    const serviceLabels: { [key: string]: string } = {
      youtube: "YouTube Music",
      apple: "Apple Music",
      spotify: "Spotify",
    };

    modalTitle.textContent = song.title;
    modalBand.textContent = song.band;
    modalRelease.textContent = song.release || "ไม่ระบุ";
    modalSingle.textContent =
      [song.singleNo, song.singleName].filter(Boolean).join(" · ") || "ไม่ระบุ";
    modalCount.textContent = String(song.count);
    modalArt.innerHTML = song.imageUrl
      ? `<img src="${escapeSongHtml(song.imageUrl)}" alt="" />`
      : '<i class="fa-solid fa-music"></i>';
    modalLinks.innerHTML =
      Object.entries(song.links)
        .filter(([, url]) => url)
        .map(([service, url]) => {
          const meta = songLinkMeta[service];
          const label = serviceLabels[service] || service;
          return `<a class="song-modal__link-btn" href="${escapeSongHtml(url!)}" target="_blank" rel="noopener noreferrer" style="--link-color: ${meta?.color ?? "#888"};">
        <span class="song-modal__link-icon">${meta?.icon ?? ""}</span>
        <span>${label}<i class="fa-solid fa-arrow-right arrow-icon ms-1"></i></span>
      </a>`;
        })
        .join("") ||
      '<span class="song-modal__links-empty">ยังไม่มีลิงก์เพลง</span>';
    modalMembers.innerHTML = song.picks
      .map(
        (pick) =>
          `<span class="song-modal-chip"><img src="${escapeSongHtml(pick.image)}" alt="" />${escapeSongHtml(pick.name)} · ${pick.priority}</span>`,
      )
      .join("");
  });

  updateSongExplorer();

  // ── Song checker ──────────────────────────────────────────────────────
  const sel1 = document.getElementById(
    "ge-person-1",
  ) as HTMLSelectElement | null;
  const sel13 = document.getElementById(
    "ge-person-13",
  ) as HTMLSelectElement | null;
  const sel25 = document.getElementById(
    "ge-person-25",
  ) as HTMLSelectElement | null;
  const resultBox = document.getElementById("ge2026-checker-result");

  function renderChecker() {
    if (!resultBox) return;
    const rank1Id = sel1?.value || null;
    const rank13Id = sel13?.value || null;
    const rank25Id = sel25?.value || null;

    if (!rank1Id && !rank13Id && !rank25Id) {
      resultBox.innerHTML =
        '<span class="checker-result__placeholder"><i class="fa-regular fa-circle-question"></i> เลือกเมมเบอร์ด้านบนเพื่อดูผล</span>';
      return;
    }

    const resolved = resolveCenterSongs(
      { rank1Id, rank13Id, rank25Id },
      ge2026Candidates,
    );

    resultBox.innerHTML = resolved
      .filter(
        (r: import("@/types/ge2026").Ge2026CenterResolution) => r.candidate,
      )
      .map((r: import("@/types/ge2026").Ge2026CenterResolution) => {
        const candidate = r.candidate!;
        const img = getGe2026ImageUrl(candidate);
        const priorityText = r.priorityUsed
          ? `เลือกเพลงนี้เป็นอันดับ ${r.priorityUsed}`
          : "-";
        return `
          <div class="checker-result-row">
            <img src="${img}" alt="${candidate.name}" class="checker-result-row__img" width="36" height="36" loading="lazy" />
            <div class="checker-result-row__body">
              <div class="checker-result-row__category">${CATEGORY_LABEL[r.category]}</div>
              <div class="checker-result-row__song">${r.song ?? "—"}</div>
              <div class="checker-result-row__meta">${candidate.name} · ${candidate.band} · ${priorityText}</div>
            </div>
          </div>`;
      })
      .join("");
  }

  [sel1, sel13, sel25].forEach((el) =>
    el?.addEventListener("change", renderChecker),
  );

  // ── Countdown Timer ───────────────────────────────────────────────────
  const targetDate = new Date("2026-10-01T12:00:00+07:00").getTime();
  const updateCountdown = () => {
    const now = new Date().getTime();
    const distance = targetDate - now;

    const elDays = document.getElementById("cd-days");
    const elHours = document.getElementById("cd-hours");
    const elMins = document.getElementById("cd-mins");
    const elSecs = document.getElementById("cd-secs");

    if (!elDays || !elHours || !elMins || !elSecs) return;

    if (distance < 0) {
      elDays.innerText = "00";
      elHours.innerText = "00";
      elMins.innerText = "00";
      elSecs.innerText = "00";
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
    );
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    elDays.innerText = String(days).padStart(2, "0");
    elHours.innerText = String(hours).padStart(2, "0");
    elMins.innerText = String(minutes).padStart(2, "0");
    elSecs.innerText = String(seconds).padStart(2, "0");
  };

  updateCountdown();
  setInterval(updateCountdown, 1000);

  // ── Candidate Modal ───────────────────────────────────────────────────
  const candidateItems = document.querySelectorAll(".candidate-item");
  const candidateModalEl = document.getElementById("ge2026-candidate-modal");
  const modalContent = document.getElementById(
    "ge2026-candidate-modal-content",
  );

  if (candidateModalEl && modalContent) {
    window.addEventListener("message", (event) => {
      if (
        event.origin !== "https://platform.twitter.com" &&
        event.origin !== "https://platform.x.com"
      ) {
        return;
      }

      const iframe = document.getElementById(
        "ge2026-tweet-embed",
      ) as HTMLIFrameElement | null;
      if (!iframe) return;

      let data: any = event.data;
      if (typeof data === "string") {
        try {
          data = JSON.parse(data);
        } catch {
          return;
        }
      }

      const height =
        data?.params?.height ??
        data?.params?.[0]?.height ??
        data?.["twttr.embed"]?.params?.height;
      if (typeof height === "number" && height > 0) {
        iframe.style.height = `${height}px`;
      }
    });

    candidateItems.forEach((item) => {
      item.addEventListener("click", () => {
        const el = item as HTMLElement;
        const name = el.dataset.name;
        const brand = el.dataset.brand;
        const team = el.dataset.team;
        const gen = el.dataset.gen;
        const expectation = el.dataset.expectation;
        const postUrl = el.dataset.posturl;
        const applicationText = decodeURIComponent(el.dataset.apptext || "");
        const escapeHtml = (value: string) =>
          value.replace(
            /[&<>'"]/g,
            (character) =>
              ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                "'": "&#39;",
                '"': "&quot;",
              })[character] || character,
          );
        const appText = escapeHtml(applicationText).replace(/\r?\n/g, "<br>");
        const imageUrl = el.dataset.imageurl;
        let songs: string[] = [];
        try {
          if (el.dataset.songs) songs = JSON.parse(el.dataset.songs);
        } catch (e) {}

        let html = `
          <div class="d-flex align-items-center gap-3 mb-4 mt-2">
            <img src="${imageUrl}" alt="${name}" class="rounded-circle object-fit-cover flex-shrink-0" width="80" height="80" />
            <div>
              <h4 class="fw-bold mb-1" style="color: var(--c-content);">${name}</h4>
              <div class="fw-semibold" style="color: var(--c-${brand?.toLowerCase().replace("48", "")});">${brand} ${team} ${gen !== "Unknown" ? `(${gen})` : ""}</div>
              <span class="text-secondary small mb-2" style="color: var(--c-secondary);">อันดับที่คาดหวัง : </span>
              <span class="fw-semibold text-secondary" style="color: var(--c-content);">${expectation && expectation !== "undefined" ? expectation : "-"}</span>
            </div>
          </div>

          <div class="mb-4">
            <div class="fw-bold small mb-2" style="color: var(--c-content-secondary);">ข้อความการสมัคร</div>
            <div class="small mb-0" style="color: var(--c-content); line-height: 1.6;">${appText}</div>
          </div>
        `;

        if (postUrl && postUrl !== "undefined") {
          const tweetId = postUrl.match(/status\/(\d+)/)?.[1] ?? "";
          if (tweetId) {
            html += `
              <div class="mt-4 pt-4 border-top" style="border-color: var(--c-border) !important;">
                <blockquote class="twitter-tweet" style="display: block;">
                  <a href="${postUrl}"></a>
                </blockquote>
              </div>
            `;
          }
        }

        modalContent.innerHTML = html;

        if (postUrl && postUrl !== "undefined") {
          const tweetId = postUrl.match(/status\/(\d+)/)?.[1] ?? "";
          if (tweetId) {
            const existingScript = document.querySelector(
              'script[src="https://platform.x.com/widgets.js"]',
            );
            if (!existingScript) {
              const script = document.createElement("script");
              script.async = true;
              script.charset = "utf-8";
              script.src = "https://platform.x.com/widgets.js";
              document.body.appendChild(script);
            } else if ((window as any).twttr?.widgets) {
              (window as any).twttr.widgets.load();
            }
          }
        }
      });
    });
  }
</script>