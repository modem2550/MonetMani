                <div class={`col-12 col-lg-4 stagger-${idx + 1}`}>
                  <div
                    class="d-flex align-items-center gap-2 px-3 py-2 fw-bold"
                    style={`background: ${group.bg} !important; color: #fff; border-radius: var(--r-base) var(--r-base) 0 0;`}
                  >
                    {group.title} ({group.data.length})
                  </div>
                  <div style="border-color: var(--c-border); border-left: 1.5px solid var(--c-border); border-right: 1.5px solid var(--c-border); border-bottom: 1.5px solid var(--c-border); border-radius: 0 0 var(--r-base) var(--r-base">
                    <div class="list-group list-group-flush">
                      {(() => {
                        const grouped = group.data.reduce(
                          (acc: any, c: any) => {
                            const g = getExpectedRankGroupTitle(c.expectation);
                            if (!acc[g.title])
                              acc[g.title] = {
                                title: g.title,
                                order: g.order,
                                items: [],
                              };
                            acc[g.title].items.push(c);
                            return acc;
                          },
                          {} as any,
                        );
                        const sortedGroups: any[] = Object.values(grouped).sort(
                          (a: any, b: any) => a.order - b.order,
                        );

                        return sortedGroups.map((sg: any) => (
                          <div class="expected-rank-group">
                            <div
                              class="expected-rank-group-title py-1 px-3 small fw-bold"
                              style="background: var(--c-bg-mute, rgba(0,0,0,0.03)); color: var(--c-content);"
                            >
                              {sg.title} ({sg.items.length} คน)
                            </div>
