        <div class="d-flex flex-column align-items-center">
          <div
            class="fs-1 fw-bold text-content"
            id="cd-days"
            style="line-height: 1; color: var(--c-content);"
          >
            00
          </div>
          <div
            class="small fw-semibold text-secondary text-uppercase mt-1"
          >
            Days
          </div>
        </div>
        <div class="fs-1 fw-bold text-secondary" style="line-height: 1;">:</div>
        <div class="d-flex flex-column align-items-center">
          <div
            class="fs-1 fw-bold text-content"
            id="cd-hours"
            style="line-height: 1; color: var(--c-content);"
          >
            00
          </div>
          <div
            class="small fw-semibold text-secondary text-uppercase mt-1"
          >
            Hours
          </div>
        </div>
        <div class="fs-1 fw-bold text-secondary" style="line-height: 1;">:</div>
        <div class="d-flex flex-column align-items-center">
          <div
            class="fs-1 fw-bold text-content"
            id="cd-mins"
            style="line-height: 1; color: var(--c-content);"
          >
            00
          </div>
          <div
            class="small fw-semibold text-secondary text-uppercase mt-1"
          >
            Minutes
          </div>
        </div>
        <div class="fs-1 fw-bold text-secondary" style="line-height: 1;">:</div>
        <div class="d-flex flex-column align-items-center">
          <div
            class="fs-1 fw-bold text-content"
            id="cd-secs"
            style="line-height: 1; color: var(--c-content);"
          >
            00
          </div>
          <div
            class="small fw-semibold text-secondary text-uppercase mt-1"
          >
            Seconds
          </div>
        </div>
      </div>
      <div class="text-secondary mt-3 fade-in">
        เปิดโหวต 1 ตุลาคม 2026 12:00 เป็นต้นไป
      </div>
    </div>

    {/* ── Tabs (3 top-level tabs: Candidates / Song / Result) ─────────── */}
    <div class="tab-content pb-5">
      {/* ── Candidates ─────────────────────────────────────────────────── */}
      <section
        class="tab-pane fade show active"
        id="ge-candidates"
        role="tabpanel"
      >
        {/* View switcher — shows ONE of the two panels below at a time */}
        <div class="d-flex justify-content-between button-panel">
          <div class="mb-4 fade-in d-flex gap-2 serch-box">
            <input
              type="search"
              class="form-control rounded-pill px-4 py-2 bg-transparent text-body flex-grow-1"
              id="ge2026-candidate-search"
              placeholder="ค้นหาจากชื่อเมมเบอร์ หรือชื่อเพลง..."
              autocomplete="off"
              style="border-color: var(--c-border); color: var(--c-content-muted) !important;"
            />
            <button
              class="btn btn-outline-secondary rounded-pill text-nowrap px-3"
