---
// src/pages/election/ge2026.astro
//
// BNK48 & CGM48 Senbatsu General Election 2026 (GE6) — fan tracker page.
// Moved from src/pages/planner/ge-2026.astro to live under the new
// /election hub (src/pages/election/index.astro), which lists every event
// registered with features.election.enabled — see
// src/features/events/data/ge-2026.ts for this event's config.
//
// Candidates + song catalogue are hardcoded (see
// src/features/events/data/ge-2026.ts, which merges what used to be
// ge2026-candidates.ts + ge2026-song-meta.ts) — only the RESULT tab is
// database-backed via Supabase, so results can be updated by editing the
// `ge2026_final_results` table directly (Table Editor or SQL), with no
// code change / git push / redeploy required.
//
// NOTE ON THE DATA MODEL CHANGE (2026 redesign):
// The Result tab used to be 4 separate tabs (ผลด่วน#1 / ผลด่วน#2 / ผลจริง /
// Result-summary). They are now merged into ONE tab with 3 stage buttons
// that switch between "prelim1" | "prelim2" | "final", each rendering the
// same 3 rank-based groups (Senbatsu 1-12 / Under Girls 13-24 / Next Girls
// 25-36). This requires `Ge2026ResultRow` to carry a `stage` column and
// `getGe2026FinalResults()` to select it — see the SQL migration shared
// alongside this file. `rank` is expected to be unique per stage (1-36).
//
// `prerender = false` makes this route render per-request on Vercel, so the
// Supabase fetch below always returns the current data.

export const prerender = false;

import MainLayout from "@/app/layouts/MainLayout.astro";
import "@/shared/styles/ge2026.scss";

import {
  ge2026Candidates,
  getGe2026ImageUrl,
  getGe2026SongMeta,
} from "@/features/events/data/ge-2026";
import {
  CATEGORY_LABEL,
  aggregateSongStats,
  resolveCenterSongs,
} from "@/features/events/ge2026SongEngine";
import type { Ge2026SongStat, Ge2026ResultRow } from "@/types/ge2026";
import { getGe2026FinalResults } from "@/services/supabase/ge2026";
import { getActiveMembers } from "@/services/supabase/members";

// ── Supabase fetch with error handling ──────────────────────────────────────
let activeMembers: any[] = [];
let finalRows: Ge2026ResultRow[] = [];

try {
  activeMembers = await getActiveMembers();
} catch (e) {
  console.error("[ge-2026] failed to load active members", e);
}

try {
  // getGe2026FinalResults() must select the `stage` column too
  // ('prelim1' | 'prelim2' | 'final'). See migration SQL.
  finalRows = await getGe2026FinalResults();
} catch (e) {
  console.error("[ge-2026] failed to load final results", e);
}

// ── Enhanced candidates ──────────────────────────────────────────────────────
const enhancedCandidates = ge2026Candidates.map((c) => {
  const member = activeMembers.find(
    (m) => m.name?.toLowerCase() === c.name.toLowerCase() && m.brand === c.band,
  );
  return {
    ...c,
    gen: member?.gen ?? "Unknown",
    band: (member?.brand ?? c.band) as typeof c.band,
    team: member?.team ?? c.team,
  };
});

const bnk48Candidates = enhancedCandidates.filter((c) => c.band === "BNK48");
const cgm48Candidates = enhancedCandidates.filter((c) => c.band === "CGM48");

// Sorted-by-name roster used to populate the Song Checker's 3 <select>s.
const checkerRoster = [...enhancedCandidates].sort((a, b) =>
  a.name.localeCompare(b.name),
);

// ── Helper functions ─────────────────────────────────────────────────────────
function getCandidateExpectationGroup(expectation: string | undefined) {
  if (!expectation) return "Next Girls";
  const text = expectation.toLowerCase();
  if (
    text.includes("senbatsu") ||
    text.includes("kami") ||
    text.includes("front member") ||
    text.includes("center (1")
  ) {
    return "Senbatsu";
  }
  if (
    text.includes("next girls") ||
    text.includes("อันดับ 25") ||
    text.includes("อันดับ 26") ||
    text.includes("อันดับ 27")
  ) {
    return "Next Girls";
  }
  if (
    text.includes("under girls") ||
    text.includes("อันดับ 19") ||
    text.includes("อันดับ 20") ||
    text.includes("อันดับ 22")
  ) {
    return "Under Girls";
  }

  const match = text.match(/อันดับ (\d+)/);
  if (match) {
    const rank = parseInt(match[1]);
    if (rank <= 12) return "Senbatsu";
    if (rank <= 24) return "Under Girls";
    return "Next Girls";
  }
  return "Next Girls";
}

function getCandidateExpectedRank(expectation: string | undefined): number {
  if (!expectation) return 999;
  const text = expectation.toLowerCase();

  const match = text.match(/อันดับ (\d+)/);
  if (match) return parseInt(match[1]);

  if (text.includes("center (1")) return 1;
  if (text.includes("kami 7")) return 7;
  if (text.includes("senbatsu") || text.includes("front member")) return 16;
  if (text.includes("under girls")) return 24;
  if (text.includes("next girls")) return 36;

  return 999;
}

function getExpectedRankGroupTitle(expectation: string | undefined): {
  title: string;
  order: number;
} {
  if (!expectation) return { title: "ไม่ระบุ", order: 999 };
  const text = expectation.toLowerCase();

  if (
    text.includes("อันดับ 1") &&
    !text.includes("12") &&
    !text.includes("13") &&
    !text.includes("1-")
  )
    return { title: "อันดับ 1", order: 1 };
  if (text.includes("center") && text.includes("kami 7"))
    return { title: "Center กลุ่มใดก็ได้ (1, 13, 25)", order: 1.1 };
  if (text.includes("center") || text.includes("front mem"))
    return {
      title: "Front Member กลุ่มใดก็ได้ (2-3, 14-15, 26-27)",
      order: 2,
    };
  if (text.includes("อันดับ 3-7")) return { title: "อันดับ 3-7 ", order: 3.5 };
  if (text.includes("อันดับ 3")) return { title: "อันดับ 3", order: 3 };
  if (text.includes("อันดับ 4")) return { title: "อันดับ 4", order: 4 };
  if (text.includes("อันดับ 5")) return { title: "อันดับ 5", order: 5 };
  if (
    text.includes("อันดับ 7") ||
    text.includes("lucky 7") ||
    text.includes("เจ็ด")
  )
    return { title: "อันดับ 7", order: 7 };
  if (text.includes("kami 7") || text.includes("12-7"))
    return { title: "Kami 7 (1-7)", order: 7.5 };
  if (text.match(/อันดับ 12\b/) || expectation === "12")
    return { title: "อันดับ 12", order: 12 };
  if (text.includes("senbatsu") || text.match(/1-1[23]/))
    return { title: "Senbatsu (1-12)", order: 12.5 };

  if (text.match(/อันดับ 13\b/)) return { title: "อันดับ 13", order: 13 };
  if (text.match(/อันดับ 19\b/)) return { title: "อันดับ 19", order: 19 };
  if (text.match(/อันดับ 20\b/)) return { title: "อันดับ 20", order: 20 };
  if (text.match(/อันดับ 21\b/)) return { title: "อันดับ 21", order: 21 };
  if (text.match(/อันดับ 22\b/)) return { title: "อันดับ 22", order: 22 };
  if (text.includes("under girls"))
    return { title: "Under Girls (13-24)", order: 24.5 };

  if (text.match(/อันดับ 25\b/)) return { title: "อันดับ 25", order: 25 };
  if (text.match(/อันดับ 26\b/)) return { title: "อันดับ 26", order: 26 };
  if (text.match(/อันดับ 27\b/)) return { title: "อันดับ 27", order: 27 };
  if (text.includes("next girls"))
    return { title: "Next Girls  (25-36)", order: 36.5 };

  const match = text.match(/อันดับ (\d+)/);
  if (match) return { title: `อันดับ ${match[1]}`, order: parseInt(match[1]) };

  return { title: expectation, order: getCandidateExpectedRank(expectation) };
}

function sortByRankAndName(a: any, b: any) {
  const rankA = getCandidateExpectedRank(a.expectation);
  const rankB = getCandidateExpectedRank(b.expectation);
  if (rankA !== rankB) return rankA - rankB;
  return a.name.localeCompare(b.name);
}

// Band → CSS color variable. Both candidate-card layouts need this (the
// BNK48/CGM48 list view previously hardcoded var(--c-bnk)/var(--c-cgm) per
// column, while the expectation view derived it dynamically from c.band) —
// one function now covers both so the mapping only lives in one place.
function bandColorVar(band: string) {
  return `var(--c-${band.toLowerCase().replace("48", "")})`;
}

// Shared data-* attributes for a candidate card. Identical markup/behaviour
// to what was previously written out by hand in three separate places
// (BNK48 list, CGM48 list, expectation-group view) — spread this object
// onto the card element instead (`{...candidateAttrs(c)}`) so the wiring for
// the click-to-open-modal card only has to be maintained once.
function candidateAttrs(c: any) {
  return {
    "data-bs-toggle": "modal",
    "data-bs-target": "#ge2026-candidate-modal",
    "data-search": `${c.name} ${c.songs.join(" ")}`.toLowerCase(),
    "data-brand": c.band,
    "data-team": c.team,
    "data-gen": c.gen,
    "data-name": c.name,
    "data-expectation": c.expectation,
    "data-posturl": c.postUrl,
    "data-apptext": encodeURIComponent(c.applicationText ?? ""),
    "data-songs": JSON.stringify(c.songs || []),
    "data-imageurl": getGe2026ImageUrl(c),
    "data-imagereg": c.imageReg,
  };
}

// ── Grouped candidates ───────────────────────────────────────────────────────
const senbatsuExpCandidates = enhancedCandidates
  .filter((c) => getCandidateExpectationGroup(c.expectation) === "Senbatsu")
  .sort(sortByRankAndName);

const underGirlsExpCandidates = enhancedCandidates
  .filter((c) => getCandidateExpectationGroup(c.expectation) === "Under Girls")
  .sort(sortByRankAndName);

const nextGirlsExpCandidates = enhancedCandidates
  .filter((c) => getCandidateExpectationGroup(c.expectation) === "Next Girls")
  .sort(sortByRankAndName);

// Shared band list: the candidate filter modal ("วง (Brand)") and the song
// filter categories ("วงเมมเบอร์") both need the sorted set of unique bands
// among enhancedCandidates — compute it once and reuse it in both places.
const bandOptions = Array.from(
  new Set(enhancedCandidates.map((c) => c.band)),
).sort();
const filterBrands = bandOptions;
const filterTeams = Array.from(
  new Set(enhancedCandidates.map((c) => c.team)),
).sort();
const filterGens = Array.from(
  new Set(enhancedCandidates.map((c) => c.gen)),
).sort();

// ── Song stats ───────────────────────────────────────────────────────────────
const songStats = aggregateSongStats(enhancedCandidates);

const songBandCounts = (() => {
  const counts = new Map<string, number>();
  for (const stat of songStats) {
    const meta = getGe2026SongMeta(stat.song);
    const band = meta?.band ?? "ไม่ระบุวง";
    counts.set(band, (counts.get(band) ?? 0) + 1);
  }
  return Array.from(counts.entries())
    .map(([band, count]) => ({ band, count }))
    .sort((a, b) => b.count - a.count);
})();

const songCardData = songStats.map((stat: Ge2026SongStat, idx: number) => {
  const meta = getGe2026SongMeta(stat.song);
  return {
    id: `ge2026-song-${idx}`,
    title: stat.song,
    count: stat.count,
    band: meta?.band ?? "ไม่ระบุวง",
    singleName: meta?.singleName ?? null,
    singleNo: meta?.singleNo ?? null,
    release: meta?.release ?? null,
    note: meta?.note ?? null,
    imageUrl: meta?.imageUrl ?? null,
    links: meta?.links ?? { youtube: null, apple: null, spotify: null },
    picks: stat.picks.map((p) => ({
      name: p.candidate.name,
      band: p.candidate.band,
      gen: p.candidate.gen,
      team: p.candidate.team,
      priority: p.priority,
      image: getGe2026ImageUrl(p.candidate),
    })),
  };
});

// ── Song filter categories ──────────────────────────────────────────────────
type Ge2026FilterOption = { value: string; label: string; count: number };
type Ge2026FilterCategory = {
  key: string;
  label: string;
  icon: string;
  options: Ge2026FilterOption[];
};

function countSongsMatching(
  predicate: (song: (typeof songCardData)[number]) => boolean,
) {
  return songCardData.filter(predicate).length;
}

const priorityLabels: Record<number, string> = {
  1: "อันดับ 1",
  2: "อันดับ 2",
  3: "อันดับ 3",
};

const memberBands = bandOptions;

const filterCategories: Ge2026FilterCategory[] = [
  {
    key: "band",
    label: "วง (ต้นฉบับเพลง)",
    icon: "fa-compact-disc",
    options: songBandCounts.map(({ band, count }) => ({
      value: band,
      label: band,
      count,
    })),
  },
  {
    key: "priority",
    label: "อันดับที่เลือก",
    icon: "fa-list-ol",
    options: [1, 2, 3].map((p) => ({
      value: String(p),
      label: priorityLabels[p],
      count: countSongsMatching((song) =>
        song.picks.some((pick) => pick.priority === p),
      ),
    })),
  },
  {
    key: "memberBand",
    label: "วงเมมเบอร์",
    icon: "fa-people-group",
    options: memberBands.map((band) => ({
      value: band,
      label: band,
      count: countSongsMatching((song) =>
        song.picks.some((pick) => pick.band === band),
      ),
    })),
  },
  {
    key: "gen",
    label: "รุ่น",
    icon: "fa-layer-group",
    options: filterGens.map((gen) => ({
      value: gen,
      label: gen,
      count: countSongsMatching((song) =>
        song.picks.some((pick) => pick.gen === gen),
      ),
    })),
  },
  {
    key: "team",
    label: "ทีม",
    icon: "fa-flag",
    options: filterTeams.map((team) => ({
      value: team,
      label: team,
      count: countSongsMatching((song) =>
        song.picks.some((pick) => pick.team === team),
      ),
    })),
  },
];

// ── Shared rank-group definitions (title / gradient / rank range) ──────────
// Used by BOTH the Result tab (resultCategories, keyed 1-12/13-24/25-36) and
// the Candidates tab's "อันดับที่คาดหวัง" view (which needs the same three
// titles + gradients, just without the min/max cutoffs). Keeping this as
// ONE array means the two tabs can never visually drift out of sync, and the
// gradient itself is now defined a single time in ge2026.scss
// (--ge-grad-senbatsu / --ge-grad-undergirls / --ge-grad-nextgirls) instead
// of being duplicated as raw linear-gradient() strings in two places here.
const GE2026_RANK_GROUPS = [
  {
    key: "senbatsu",
    title: "Senbatsu (1-12)",
    bg: "var(--ge-grad-senbatsu)",
    min: 1,
    max: 12,
  },
  {
    key: "undergirls",
    title: "Under Girls (13-24)",
    bg: "var(--ge-grad-undergirls)",
    min: 13,
    max: 24,
  },
  {
    key: "nextgirls",
    title: "Next Girls (25-36)",
    bg: "var(--ge-grad-nextgirls)",
    min: 25,
    max: 36,
  },
] as const;

// ── Result tab: 3 fixed rank-based categories, shared by every stage ────────
const resultCategories = GE2026_RANK_GROUPS;

const resultStages = [
  { key: "prelim1", label: "First Preliminary" },
  { key: "prelim2", label: "Second Preliminary " },
  { key: "final", label: "Final Results" },
] as const;

function rowsForStageAndCategory(
  stage: string,
  min: number,
  max: number,
): Ge2026ResultRow[] {
  return finalRows
    .filter((r: any) => r.round === stage && r.rank >= min && r.rank <= max) // ← r.rank ใช้ได้แล้ว
    .sort((a: any, b: any) => a.rank - b.rank);
}

type Ge2026Stage = (typeof resultStages)[number]["key"]; // "prelim1" | "prelim2" | "final"

const RESULT_STAGE_ORDER = resultStages.map((s) => s.key) as Ge2026Stage[];

function getPreviousStageKey(stage: Ge2026Stage): Ge2026Stage | null {
  const idx = RESULT_STAGE_ORDER.indexOf(stage);
  return idx > 0 ? RESULT_STAGE_ORDER[idx - 1] : null;
}

type RankChange = { prevRank: number; diff: number } | "new" | null;

function getRankChange(
  stage: Ge2026Stage,
  currentRank: number,
  memberName: string | undefined,
  band: string | undefined,
): RankChange {
  if (!memberName) return null;

  const prevStage = getPreviousStageKey(stage);
  if (!prevStage) return null;

  const prevRow: any = finalRows.find(
    (r: any) =>
      r.round === prevStage &&
      r.member_name?.toLowerCase() === memberName.toLowerCase() &&
      (!band || r.band === band),
  );

  if (!prevRow) return "new";
  if (prevRow.rank == null) return null;

  return { prevRank: prevRow.rank, diff: prevRow.rank - currentRank };
}

function getCandidateIdByNameBand(
  name: string | undefined | null,
  band?: string | null,
): string | null {
  if (!name) return null;
  const candidate = enhancedCandidates.find(
    (c) =>
      c.name.toLowerCase() === name.toLowerCase() && (!band || c.band === band),
  );
  return candidate?.id ?? null;
}

function resolveStageCenterSongs(stage: string): Record<string, string | null> {
  const rank1Row: any = finalRows.find(
    (r: any) => r.round === stage && r.rank === 1,
  );
  const rank13Row: any = finalRows.find(
    (r: any) => r.round === stage && r.rank === 13,
  );
  const rank25Row: any = finalRows.find(
    (r: any) => r.round === stage && r.rank === 25,
  );

  const resolved = resolveCenterSongs(
    {
      rank1Id: getCandidateIdByNameBand(rank1Row?.member_name, rank1Row?.band),
      rank13Id: getCandidateIdByNameBand(
        rank13Row?.member_name,
        rank13Row?.band,
      ),
      rank25Id: getCandidateIdByNameBand(
        rank25Row?.member_name,
        rank25Row?.band,
      ),
    },
    ge2026Candidates,
  );

  const songByCategory: Record<string, string | null> = {};
  for (const r of resolved) songByCategory[r.category] = r.song;
  return songByCategory;
}

const hasAnyResults = finalRows.length > 0;
---

<MainLayout
  title="BNK48 & CGM48 Senbatsu General Election 2026 Fansite - Niya BNK48's"
  description="รายชื่อเมมเบอร์ที่ลงสมัคร และ รายชื่อเพลงที่เมมเบอร์สมัตร ภายใน BNK48 & CGM48 Senbatsu General Election 2026"
  socialImage="/img/GE-2026.jpeg"
>
<nav class="ge2026-tabs mb-4">
      <div
        class="nav nav-pills justify-content-center flex-nowrap overflow-x-auto gap-3"
        role="tablist"
        style="scrollbar-width: none;"
      >
        <button
          class="nav-link rounded-pill px-3 fw-bold active"
          data-bs-toggle="pill"
          data-bs-target="#ge-candidates"
          type="button"
          role="tab"
          style="white-space: nowrap;">Candidates</button
        >
        <button
          class="nav-link rounded-pill px-3 fw-bold"
          data-bs-toggle="pill"
          data-bs-target="#ge-songs"
          type="button"
          role="tab"
          style="white-space: nowrap;">Song</button
        >
        <button
          class="nav-link rounded-pill px-3 fw-bold"
          data-bs-toggle="pill"
          data-bs-target="#ge-result"
          type="button"
          role="tab"
          style="white-space: nowrap;">Result</button
        >
      </div>
    </nav>
  <div class="px-4 ge-page container">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <div class="text-center pb-5 slide-up">
      <div class="fade-in stagger-2 mb-2">
        <h2
          class="fs-4 fs-md-3 fw-bold mb-1"
