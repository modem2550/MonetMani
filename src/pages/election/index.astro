---
// src/pages/election/index.astro
//
// Listing hub for election-type events (BNK48 & CGM48 Senbatsu General
// Election, and future election events). Copied from
// src/pages/planner/index.astro and adapted to read from
// getElectionEvents() / event.features.election instead of
// getPlannerEvents() / event.features.planner, so this hub only ever shows
// events explicitly opted into the "election" feature.

import MainLayout from "@/app/layouts/MainLayout.astro";
import {
    getElectionEvents,
} from "@/features/events/eventEngine";
import "@/shared/styles/planner.scss";

const ALL_ELECTION_EVENTS = await getElectionEvents();

const title = "Elections - Niya BNK48";
const description =
    "เลือกงานเลือกตั้งแล้ววางแผนตาราง ติดตามผล และเมมเบอร์ที่อยากเชียร์ — เครื่องมือสำหรับแฟนคลับ";
---

<MainLayout title={title} description={description}>
    <div class="planner-hub container" aria-labelledby="election-hub-heading">
        <!-- ── Election Events ── -->
        <header class="planner-hub__intro">
            <div>
                <h1 id="election-hub-heading" class="planner-hub__title mb-2">
                    Election Events
                </h1>
                <p class="planner-hub__lead mb-0">
                    ติดตามและวางแผนสำหรับงานเลือกตั้งของแต่ละวง
                </p>
            </div>
        </header>
        <div class="mb-5 ranking-ad" aria-labelledby="election-heading">
            {
                ALL_ELECTION_EVENTS.length === 0 ? (
                    <p class="planner-hub__empty mb-0">
                        ยังไม่มีงานเลือกตั้งให้เลือกในขณะนี้ —
                        โปรดกลับมาดูใหม่ภายหลัง
                    </p>
                ) : (
                    <section class="p-0">
                        <div class="row row-cols-1 row-cols-sm-2 g-4">
                            {ALL_ELECTION_EVENTS.map((event) => (
                                <div class="col d-flex justify-content-center">
                                    <article
                                        class="planner-card__article d-flex flex-column h-100 overflow-hidden"
                                        style={`--planner-accent: ${event.primaryColor};`}
                                    >
                                        <a
                                            class="planner-card__media"
                                            href={`/election/${event.slug}`}
                                            aria-label={`Open election page for ${event.name}`}
                                        >
                                            <img
                                                src={
                                                    event.features.election
                                                        ?.listingImage ??
                                                    event.features.election
                                                        ?.heroImage
                                                }
                                                alt={event.name}
                                                width="960"
                                                height="540"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </a>
                                        <div class="planner-card__body d-flex flex-column flex-grow-1">
                                            <h2 class="h6 planner-card__title">
                                                <a
                                                    href={`/election/${event.slug}`}
                                                >
                                                    {event.name}
                                                </a>
                                            </h2>
                                            <p class="planner-card__desc">
                                                {
                                                    event.features.election
                                                        ?.description
                                                }
                                            </p>
                                            <div class="planner-card__actions d-flex flex-wrap align-items-center">
                                                <a
                                                    class="btn planner-card__cta"
                                                    href={`/election/${event.slug}`}
                                                >
                                                    เปิดหน้าเลือกตั้ง
                                                    <i
                                                        class="fa-solid fa-arrow-right arrow-icon ms-1"
                                                        aria-hidden="true"
                                                    />
                                                </a>
                                                <a
                                                    class="planner-card__official d-inline-flex align-items-center position-relative"
                                                    href={
                                                        event.features.election
                                                            ?.officialLink
                                                    }
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >
                                                    ข้อมูลทางการ
                                                    <i
                                                        class="fa-solid fa-arrow-up-right-from-square"
                                                        aria-hidden="true"
                                                    />
                                                    <span class="sr-only">
                                                        (opens in new window)
                                                    </span>
                                                </a>
                                            </div>
                                        </div>
                                    </article>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }
        </div>
    </div>
</MainLayout>
<style>
    .container {
        max-width: 1320px !important;
        margin: 0 auto;
    }
</style>