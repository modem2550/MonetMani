---
// MainLayout.astro
import "@/shared/styles/main.scss";
import "@/shared/styles/schedule.scss";
import "@/shared/styles/gallery.scss";
import IconSprite from "@/shared/components/IconSprite.astro";
import { Image } from "astro:assets";
import logoWhite from "@/shared/assets/logo/WHITE.png";
import logoBlack from "@/shared/assets/logo/BLACK.png";
// Removed unused import of SITE_URL and buildPageSchema
import { buildPageSchema } from "@/shared/utils/schema"; 
// ImportMetaEnv interface removed as it was unused

const {
  title = "Monet BNK48 - Fan Website",
  description = "ติดตามและเป็นกำลังใจให้กับ Monet BNK48 ผ่านเว็บไซต์แฟนคลับอย่างเป็นทางการนี้ ที่นี่คุณจะได้พบกับข่าวสารล่าสุด ตารางงาน กิจกรรม และคลังรูปภาพของ Monet BNK48 ที่ทำไว้เพื่อแฟนคลับทุกคน",
  theme,
  forcedTheme,
  socialImage,
  noindex = false,
} = Astro.props;

const defaultSocialImage =
  "https://monimonetfans.vercel.app/logo/tw.webp";
const resolvedSocialImage = socialImage
  ? /^https?:\/\//i.test(socialImage)
    ? socialImage
    : new URL(socialImage, Astro.url).href
  : defaultSocialImage;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://monimonetfans.vercel.app"
).href;

/** `/_vercel/speed-insights/script.js` exists only on the Vercel platform, not in `astro dev` / local preview. */
const enableVercelSpeedInsights =
  import.meta.env.PROD && import.meta.env.VERCEL === "1";

// ── Theme Logic ──────────────────────────────────────────────────────────────
const isForcedLightMode = forcedTheme === "light";
const isForcedDarkMode = forcedTheme === "dark";

// Schema Markup Data สำหรับ SEO
const schemaData = buildPageSchema(description); 

---

<!doctype html>
<html lang="th" data-forced-theme={forcedTheme ?? ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Noto+Sans+Thai:wght@100..900&display=swap"
      rel="stylesheet" media="print" onload="this.setAttribute('media','all')" crossorigin="anonymous" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Noto+Sans+Thai:wght@100..900&display=swap"
        rel="stylesheet" crossorigin="anonymous" />
    </noscript>
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Monet BNK48 - Fan Website" />
    <meta property="og:image" content={resolvedSocialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="เว็บไซต์แฟนคลับของ โมเน่ต์ - ภาริตา ริเริ่มกุล (Monet BNK48) ที่รวบรวมข้อมูลข่าวสาร ไฮไลท์ผลงาน อัปเดตกิจกรรม และช่องทางการติดตาม" />
    <meta name="twitter:image" content={resolvedSocialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="nVWvhyIP60uv985UsYOMtwbOjNhvWyVoHaxPBdwnfzc" />
        
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Monet Fans" />
    <meta name="application-name" content="Monet Fans" />
    <meta name="msapplication-TileColor" content="#FAF6EC">
    <meta name="theme-color" content="#FAF6EC" id="themeColorMeta" />
    <meta name="twitter:site" content="@wishyoubestyour" />
    <meta name="twitter:creator" content="@wishyoubestyour" />
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        if (j instanceof HTMLScriptElement) {
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        }
        if (f && f.parentNode) {
          f.parentNode.insertBefore(j, f);
        }
      })(window, document, "script", "dataLayer", "GTM-NMJ8RVZ6");
    </script>
    <meta property="og:image:alt" content={title} />

    <script
      is:inline
      define:vars={{ isForcedLightMode, isForcedDarkMode }}
    >
      (() => {
        try {
          const storageKey = "monet-theme";
          let theme = "light";

          if (isForcedLightMode) {
            theme = "light";
          } else if (isForcedDarkMode) {
            theme = "dark";
          } else {
            const savedTheme = localStorage.getItem(storageKey);
            const prefersDark = window.matchMedia(
              "(prefers-color-scheme: dark)"
            ).matches;
            theme =
              savedTheme === "light" || savedTheme === "dark"
                ? savedTheme
                : prefersDark
                ? "dark"
                : "light";
          }

          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.style.colorScheme = theme;

          const themeMeta = document.getElementById("themeColorMeta");
          if (themeMeta) {
            themeMeta.setAttribute(
              "content",
              theme === "dark" ? "#10131a" : "#ffffff"
            );
          }
        } catch {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.style.colorScheme = "light";
        }
      })();
    </script>
    <!-- Schema Markup for SEO -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData.personSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData.websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData.breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData.organizationSchema)} />



    <!-- Preconnect & DNS Prefetch critical resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
    <link rel="dns-prefetch" href="https://ekiockkaoxakovrdssva.storage.supabase.co" />
    <link rel="preconnect" href="https://ekiockkaoxakovrdssva.storage.supabase.co" crossorigin />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" />
    <!-- ✅ THEME VARIABLES INJECTION -->
    {theme && (
      <style is:global set:html={`
        :root {
          --c-primary: ${theme.primary} !important;
          --c-primary-gradient: ${theme.primaryGradient ?? theme.primary} !important;
          --c-primary-hover: ${theme.primaryHover} !important;
          --ranking-primary: ${theme.primary} !important;
          --ranking-primary-gradient: ${theme.primaryGradient ?? theme.primary} !important;
          --ranking-primary-alpha: ${theme.primary}33 !important;
        }

        :root[data-theme="light"], :root:not([data-theme="dark"]) {
          ${!isForcedDarkMode ? `
          --c-bg: ${theme.bg} !important;
          --c-surface: ${theme.surface} !important;
          --c-surface-alt: ${theme.surfaceAlt} !important;
          --c-border: ${theme.border} !important;
          --c-content: ${theme.content} !important;
          --c-content-muted: ${theme.textMuted} !important;
          --c-content-secondary: ${theme.content} !important;
          ` : ''}
        }

        :root[data-theme="dark"] {
          ${isForcedDarkMode ? `
          --c-bg: ${theme.bg} !important;
          --c-surface: ${theme.surface} !important;
          --c-surface-alt: ${theme.surfaceAlt} !important;
          --c-border: ${theme.border} !important;
          --c-content: ${theme.content} !important;
          --c-content-muted: ${theme.textMuted} !important;
          --c-content-secondary: ${theme.content} !important;
          ` : ''}
        }
      `} />
    )}

    <slot name="head" />
  </head>
  <body>
    <!-- ✅ Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NMJ8RVZ6"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <IconSprite />

    <header class="site-header">
      <div
        class="header-container d-flex align-items-center justify-content-between w-100"
      >
        <!-- Logo & Branding -->
        <a
          href="/"
          class="logo-brand d-flex align-items-center"
          aria-label="Monet BNK48 — Home"
        >
          <span class="logo-brand-mark" aria-hidden="true">
            <Image
              src={logoWhite}
              alt=""
              class="logo-img logo-img-on-hero"
              width={100}
              loading="eager"
            />
            <Image
              src={logoBlack}
              alt=""
              class="logo-img logo-img-on-bar"
              width={100}
              loading="eager"
            />
          </span>
          <span class="logo-text">Monet BNK48</span>
        </a>

        <!-- Desktop Navigation -->
        <nav
          class="nav-desktop align-items-center flex-wrap justify-content-end"
          aria-label="Main"
        >
          <a href="/#home" class="nav-link">Home</a>
          <a href="/#info" class="nav-link">About Monet's</a>
          <a href="/#event" class="nav-link">Events</a>
          <a href="/#social" class="nav-link">Social Media</a>
          <a href="/#library" class="nav-link">Highlights</a>

          <a href="/schedule" class="nav-link nav-link-app">
            <i class="fa-solid fa-calendar nav-icon" aria-hidden="true"></i>
            Schedule
          </a>
          <a href="/gallery" class="nav-link nav-link-app">
            <i class="fa-solid fa-images nav-icon" aria-hidden="true"></i>
            Gallery
          </a>

          {!forcedTheme && (
            <label class="theme-toggle-v2">
              <input
                type="checkbox"
                class="theme-toggle-input"
                data-theme-toggle
                aria-label="Switch theme"
              />
              <div class="theme-toggle-icon theme-toggle-icon-sun">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59.75.75 1.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"
                  ></path>
                </svg>
              </div>
              <div class="theme-toggle-icon theme-toggle-icon-moon">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </div>
            </label>
          )}
        </nav>

        <!-- Mobile Toggle -->
        <div class="mobile-toggle-group">
          {!forcedTheme && (
            <label class="theme-toggle-v2 mobile-toggle">
              <input
                type="checkbox"
                class="theme-toggle-input"
                data-theme-toggle
                aria-label="Switch theme"
              />
              <div class="theme-toggle-icon theme-toggle-icon-sun">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59.75.75 1.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"
                  ></path>
                </svg>
              </div>
              <div class="theme-toggle-icon theme-toggle-icon-moon">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </div>
            </label>
          )}

          <button
            type="button"
            class="menu-toggle flex-column"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="site-nav-mobile"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation -->
      <nav id="site-nav-mobile" class="nav-mobile" aria-label="Main">
        <a href="/#home" class="nav-link-mobile d-flex align-items-center">
          <span>Home</span>
        </a>
        <a href="/#info" class="nav-link-mobile d-flex align-items-center">
          <span>About Monet's</span>
        </a>
        <a href="/#event" class="nav-link-mobile d-flex align-items-center">
          <span>Events</span>
        </a>
        <a href="/#social" class="nav-link-mobile d-flex align-items-center">
          <span>Social Media</span>
        </a>
        <a href="/#library" class="nav-link-mobile d-flex align-items-center">
          <span>Highlights</span>
        </a>
        <a href="/#community" class="nav-link-mobile d-flex align-items-center">
          <span>Community</span>
        </a>

        <hr class="nav-mobile-divider" />
        <a href="/schedule" class="nav-link-mobile d-flex align-items-center">
          <i class="fa-solid fa-calendar nav-icon" aria-hidden="true"></i>
          <span>Schedule</span>
        </a>
        <a href="/gallery" class="nav-link-mobile d-flex align-items-center">
          <i class="fa-solid fa-images nav-icon" aria-hidden="true"></i>
          <span>Gallery</span>
        </a>
      </nav>

      <!-- Mobile Backdrop -->
      <div class="nav-backdrop"></div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-auto">
      <div
        class="collaboration d-flex justify-content-between align-items-center flex-wrap gap-3 px-4 py-4"
      >
        <div class="colophon-credit d-flex flex-column">
          <span class="colophon-label">Fan's Project</span>
          <strong
            >Made with &#x2665; by
            <a href="https://x.com/wishyoubestyour">dem._.mo</a></strong
          >
        </div>
        <nav
          class="colophon-nav d-none d-sm-flex flex-wrap align-items-center gap-3"
          aria-label="Footer navigation"
        >
          <a href="/#home">Home</a>
          <a href="/#info">About</a>
          <a href="/#event">Events</a>
          <a href="/#social">Social</a>
          <a href="/#library">Highlights</a>
          <a href="/schedule">Schedule</a>
        </nav>
      </div>

      <section class="footer-bottom text-center py-3">
        <div class="container">
          <p class="mb-0 footer-license">
            Original Content &amp; Artist &copy; by Independent Artist
            Management (iAM).
          </p>
        </div>
      </section>
    </footer>

    <!-- Scripts for accessibility: theme toggle aria-label & mobile menu -->
    <script is:inline>
      (function () {
        // 1. Theme toggle – อัปเดต aria-label และ checked ตามสถานะธีม
        const toggles = document.querySelectorAll('[data-theme-toggle]');
        const updateToggleLabel = (el) => {
          const isDark =
            document.documentElement.getAttribute('data-theme') === 'dark';
          el.setAttribute(
            'aria-label',
            isDark ? 'Switch to light mode' : 'Switch to dark mode'
          );
          el.checked = isDark;
        };
        toggles.forEach((toggle) => {
          updateToggleLabel(toggle);
          toggle.addEventListener('change', function () {
            setTimeout(() => updateToggleLabel(this), 50);
          });
        });

        // 2. Mobile menu – จัดการ aria-expanded
        const menuToggle = document.querySelector('.menu-toggle');
        const mobileNav = document.getElementById('site-nav-mobile');
        const backdrop = document.querySelector('.nav-backdrop');

        if (menuToggle && mobileNav) {
          const openMenu = () => {
            mobileNav.classList.add('open');
            if (backdrop) backdrop.classList.add('active');
            menuToggle.setAttribute('aria-expanded', 'true');
            menuToggle.setAttribute('aria-label', 'Close menu');
            document.body.style.overflow = 'hidden';
          };

          const closeMenu = () => {
            mobileNav.classList.remove('open');
            if (backdrop) backdrop.classList.remove('active');
            menuToggle.setAttribute('aria-expanded', 'false');
            menuToggle.setAttribute('aria-label', 'Open menu');
            document.body.style.overflow = '';
          };

          menuToggle.addEventListener('click', () => {
            if (mobileNav.classList.contains('open')) {
              closeMenu();
            } else {
              openMenu();
            }
          });

          if (backdrop) {
            backdrop.addEventListener('click', closeMenu);
          }

          mobileNav.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMenu);
          });
        }
      })();
    </script>
  </body>

  {enableVercelSpeedInsights && (
    <script is:inline>
      (function () {
        var script = document.createElement('script');
        script.src = '/_vercel/speed-insights/script.js';
        script.defer = true;
        document.head.appendChild(script);
      })();
    </script>
  )}

  <script>
    import '@/features/ui/global';
  </script>
</html>